{
  "name": "@scality/s3utils",
  "version": "1.20.0",
  "engines": {
    "node": ">= 24"
  },
  "description": "Awesome scripts to use when working with S3 at scale",
  "scripts": {
    "lint": "eslint $(git ls-files '*.js')",
    "jest": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:unit": "LOCATION_CONFIG_FILE='tests/conf/locationConfig.json' yarn jest --verbose --logHeapUsage --projects jest.config.js --coverage --coverageDirectory=coverage/unit --testPathPatterns='tests/unit/[\\w/-]+\\.[tj]s'",
    "test:functional": "LOCATION_CONFIG_FILE='tests/conf/locationConfig.json' yarn jest --verbose --logHeapUsage --projects jest.config.js --coverage --coverageDirectory=coverage/functional --testPathPatterns='tests/functional/[\\w/-]+\\.[tj]s'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scality/s3utils.git"
  },
  "keywords": [
    "s3",
    "s3",
    "utilities"
  ],
  "author": "Scality",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/scality/s3utils/issues"
  },
  "homepage": "https://github.com/scality/s3utils#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.873.0",
    "@scality/arsenal": "^8.6.0",
    "@scality/cloudserverclient": "^1.0.8",
    "@senx/warp10": "^2.0.3",
    "@smithy/node-http-handler": "^4.12.1",
    "@smithy/util-retry": "^4.0.7",
    "JSONStream": "^1.3.5",
    "async": "^3.2.6",
    "bucketclient": "scality/bucketclient#8.3.0",
    "classic-level": "^3.0.0",
    "express": "^5.1.0",
    "httpagent": "scality/httpagent#1.1.0",
    "mongodb": "^6.17.0",
    "node-rdkafka": "^3.6.1",
    "node-schedule": "^2.1.1",
    "prom-client": "^15.1.3",
    "uuid": "^11.0.3",
    "vaultclient": "scality/vaultclient#8.5.1",
    "werelogs": "scality/werelogs#semver:^8.2.4",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.962.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.0",
    "@scality/eslint-config-scality": "scality/Guidelines#8.3.0",
    "@sinonjs/fake-timers": "^15.4.0",
    "eslint": "^9.39.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "10.1.2",
    "sinon": "^22.1.0"
  }
}
